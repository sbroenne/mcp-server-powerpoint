{
  "name": "powerpoint-mcp",
  "displayName": "PowerPoint MCP Server",
  "description": "PowerPoint automation for AI assistants - slides, shapes, text, tables, charts, images, notes, layouts & slide-to-image export - requires PowerPoint to be installed",
  "version": "0.1.5",
  "publisher": "sbroenne",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbroenne/mcp-server-powerpoint"
  },
  "bugs": {
    "url": "https://github.com/sbroenne/mcp-server-powerpoint/issues"
  },
  "homepage": "https://powerpointmcpserver.dev/",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "os": [
    "win32"
  ],
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "powerpoint",
    "microsoft",
    "office",
    "presentation",
    "slides",
    "automation",
    "charts",
    "tables",
    "copilot",
    "ai",
    "github copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "powerpoint-mcp",
        "label": "PowerPoint MCP Server"
      }
    ],
    "chatSkills": [
      {
        "name": "powerpoint-mcp",
        "description": "PowerPoint MCP Server skill for Windows presentation automation.",
        "path": "./skills/powerpoint-mcp/SKILL.md"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pwsh -NoProfile -File ..\\scripts\\Build-VscodeExtension.ps1",
    "lint": "oxlint src tests -D correctness -D suspicious -D perf --deny-warnings",
    "test": "vitest run",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^4.0.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^14.0.1"
  }
}
